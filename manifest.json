{
  "manifest_version": 3,
  "name": "FocusFish",
  "version": "0.1.0",
  "description": "A friendly focus companion that helps you avoid distracting websites.",
  
"permissions": [
  "storage",
  "tabs",
  "idle",
  "alarms",
  "declarativeNetRequest",
  "notifications"
]
,
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FocusFish",
    "default_popup": "popup.html"
  },
  
  "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}

}